Options +FollowSymLinks -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Route /api and /api/... to the PHP backend
  RewriteRule ^api/(.*)$ backend_php/public/index.php [QSA,L]
  RewriteRule ^api$ backend_php/public/index.php [QSA,L]

  # 2. Allow direct access to backend_php files if requested
  RewriteCond %{REQUEST_URI} ^/backend_php/ [NC]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Specifically serve index.html for root path
  RewriteRule ^$ /index.html [L]

  # 4. React Single Page App fallback for all other routes
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
